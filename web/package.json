{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --port 3300",
    "build": "next build",
    "start": "next start",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "seed:local": "node scripts/seed-local.mjs",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- ../api/openapi.yaml",
    "openapi:types": "openapi-typescript ../api/openapi.yaml -o ../api/openapi.d.ts",
    "openapi:types:check": "npm run openapi:types && git diff --exit-code -- ../api/openapi.d.ts",
    "analytics:docs": "tsx scripts/generate-analytics-docs.ts",
    "analytics:docs:check": "npm run analytics:docs && git diff --exit-code -- ../docs/analytics-events.md",
    "check": "npm run lint && npm run typecheck && npm run test && npm run openapi:check && npm run openapi:types:check && npm run analytics:docs:check && npm run build"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@base-ui/react": "^1.8.0",
    "@gravity-ui/icons": "^2.23.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "posthog-js": "1.435.8",
    "posthog-node": "5.56.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.2",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "1.63.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
