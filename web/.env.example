NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reminder emails and Delete my account (server only, never NEXT_PUBLIC_).
# Set on Vercel for Production; the cron job only runs on the production
# deployment. Supabase dashboard, Project Settings, API keys, the service_role
# (secret) key. Skips row level security: used only by the reminder cron job,
# the unsubscribe link and Delete my account (which deletes only the signed-in
# student's own sign-in record).
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string (openssl rand -hex 32). Vercel Cron sends it as
# "Authorization: Bearer <value>"; the job refuses every other request.
CRON_SECRET=
# Resend dashboard, API Keys, a key with "Sending access" for the
# send.censefinance.com domain.
RESEND_API_KEY=
# The sender, on the domain verified in Resend, for example
# Cense <reminders@send.censefinance.com>
REMINDER_FROM_EMAIL=
# Any long random string (openssl rand -hex 32). Signs the unsubscribe links;
# changing it breaks every link already sent.
REMINDER_UNSUBSCRIBE_SECRET=
# The app's public address, no trailing slash, for the links in reminder
# emails, for example https://censefinance.com
APP_BASE_URL=

# PostHog project token (Project settings, "Project token", starts with phc_).
# Public by design: it can only send events. Leave empty for no analytics at
# all, which is the right setting for local runs, tests and CI. No host
# variable: the browser always sends to /rx, forwarded to PostHog's US region
# by the rewrites in next.config.ts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Delete my account deletes the student's PostHog person with its events and
# recordings (S28). Needed wherever NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN is set;
# without them deleting an account answers "try again later" and deletes
# nothing. Server only. A personal API key (PostHog, Settings, Personal API
# keys) with only the person:write scope, and the project's numeric id (Project
# settings, "Project ID").
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Team accounts: Supabase user ids, comma-separated. Their events carry
# is_internal: true so they can be filtered out. Server only (no NEXT_PUBLIC_).
INTERNAL_STUDENT_IDS=

# Optional, local development only (never set on Vercel). Next reads the first
# from .env.local; the other three are read from the shell by the test and seed
# scripts, for example: E2E_BASE_URL=http://localhost:3400 npm run e2e
#
# Set to 1 to answer the not-yet-built endpoints in lib/api-client/pending.ts
# with fixtures instead of "not available yet". Ignored in production builds.
NEXT_PUBLIC_CENSE_MOCKS=
# Where the Playwright journey tests find the app (default http://localhost:3300).
E2E_BASE_URL=
# Mailpit in the local Supabase stack, for sign-in codes (default http://127.0.0.1:54324).
E2E_MAILPIT_URL=
# Where scripts/seed-local.mjs finds the app (default http://localhost:3300).
SEED_APP_URL=
