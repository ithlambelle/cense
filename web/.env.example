NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reminder emails and Delete my account (server only, never NEXT_PUBLIC_).
# Set on Vercel for Production; the cron job only runs on the production
# deployment. Supabase dashboard, Project Settings, API keys, the service_role
# (secret) key. Skips row level security: used only by the reminder cron job,
# the unsubscribe link and Delete my account (which deletes only the signed-in
# student's own sign-in record).
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string (openssl rand -hex 32). Vercel Cron sends it as
# "Authorization: Bearer <value>"; the job refuses every other request.
CRON_SECRET=
# Resend dashboard, API Keys, a key with "Sending access" for the
# send.censefinance.com domain.
RESEND_API_KEY=
# The sender, on the domain verified in Resend, for example
# Cense <reminders@send.censefinance.com>
REMINDER_FROM_EMAIL=
# Any long random string (openssl rand -hex 32). Signs the unsubscribe links;
# changing it breaks every link already sent.
REMINDER_UNSUBSCRIBE_SECRET=
# The app's public address, no trailing slash, for the links in reminder
# emails, for example https://censefinance.com
APP_BASE_URL=
# Optional. The alert for the reminder job: a Healthchecks.io ping URL,
# https://hc-ping.com/<uuid> (README, "Alert when the job fails or stops").
# Unset, nothing alerts.
REMINDER_HEARTBEAT_URL=
# Journey tests only, never on Vercel: Resend's address replaced by the
# stand-in the reminder job test starts (http://127.0.0.1:3598). Anything not
# on this machine is ignored.
RESEND_BASE_URL=

# Google sign-in on Cense's own address (server only, never NEXT_PUBLIC_).
# Without these, Google's account chooser says "to continue to
# <project>.supabase.co"; with them it names censefinance.com (or "Cense" once
# the Google Cloud brand is verified). Google Cloud console, APIs & Services,
# Credentials: the same OAuth 2.0 web client the Supabase Google provider uses,
# with https://www.censefinance.com/api/v1/auth/google/callback added as an
# authorized redirect URI. Set on Vercel for Production only: Google knows only
# the addresses listed there, so leave Preview empty (it keeps Supabase's flow).
# Leave empty locally. README, "Google sign-in that names Cense".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Ask Penny's typed questions (server only, never NEXT_PUBLIC_). Anthropic
# Console, API keys. Set on Vercel for Production, with a monthly spend limit
# on its workspace. Leave empty locally unless you mean to spend:
# without it Learn and Ask Penny show no field to type a question, and
# tapped questions work.
ANTHROPIC_API_KEY=

# PostHog project token (Project settings, "Project token", starts with phc_).
# Public by design: it can only send events. It also turns on error tracking,
# in the browser and on the server (src/instrumentation.ts). Leave empty for no
# analytics and no error tracking at all, which is the right setting for local
# runs, tests and CI. No host
# variable: the browser always sends to /rx, forwarded to PostHog's US region
# by the rewrites in next.config.ts; the server sends straight to that region.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Safe to spend on a Plaid sandbox bank (server only, never NEXT_PUBLIC_).
# Sandbox only: any PLAID_ENV other than "sandbox" turns safe to spend off,
# and so does any value below left empty. On Vercel, mark the secret and the
# token key Sensitive. From the Plaid dashboard, Developers, Keys (sandbox).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Seals each student's Plaid access token (AES-256-GCM) before it is stored.
# 32 random bytes: openssl rand -base64 32. One per environment. Changing it
# makes every stored token unreadable, so students would have to link again.
PLAID_TOKEN_KEY=
# Local journey tests only (never on Vercel): the stand-in Plaid server, for
# example http://127.0.0.1:3597. Only a loopback address is accepted.
PLAID_BASE_URL=

# Delete my account deletes the student's PostHog person with its events and
# recordings (S28). Needed wherever NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN is set;
# without them deleting an account answers "try again later" and deletes
# nothing. Server only. A personal API key (PostHog, Settings, Personal API
# keys) with only the person:write scope, and the project's numeric id (Project
# settings, "Project ID").
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Team accounts: Supabase user ids, comma-separated. Their events carry
# is_internal: true so they can be filtered out. Server only (no NEXT_PUBLIC_).
INTERNAL_STUDENT_IDS=

# Optional, local development only (never set on Vercel). Read from the shell
# by the test and seed scripts, for example:
# E2E_BASE_URL=http://localhost:3400 npm run e2e
# Where the Playwright journey tests find the app (default http://localhost:3300).
E2E_BASE_URL=
# The app's GOOGLE_OAUTH_CLIENT_ID, for the Google sign-in journey test
# (e2e/google-sign-in.spec.ts; skipped when unset). Any made-up value works, as
# long as the app was started with the same one.
E2E_GOOGLE_OAUTH_CLIENT_ID=
# The app's CRON_SECRET, for the reminder job's journey test (skipped locally when unset).
E2E_CRON_SECRET=
# Mailpit in the local Supabase stack, for sign-in codes (default http://127.0.0.1:54324).
E2E_MAILPIT_URL=
# Where scripts/seed-local.mjs finds the app (default http://localhost:3300).
SEED_APP_URL=
# The port of the journey tests' stand-in Claude server (default 3599,
# e2e/support/fake-claude.ts). Start the app with
# ANTHROPIC_BASE_URL=http://127.0.0.1:3599 and any ANTHROPIC_API_KEY (README).
E2E_FAKE_CLAUDE_PORT=
