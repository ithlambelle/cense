{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Values read from the Figma file Design-Systems, light-mode hi-fi quiz and sign-in frames (2026-10-16). web/src/app/globals.css mirrors the colors; a test fails if they drift.",
  "color": {
    "navy": {
      "$type": "color",
      "$value": "#0A1045",
      "$description": "Headings, labels and body text in light mode; selected answer text sits on optionSelected instead"
    },
    "indigoBlack": {
      "$type": "color",
      "$value": "#0F0B2E",
      "$description": "Input text and secondary button text; bottom bar"
    },
    "violet": {
      "$type": "color",
      "$value": "#9740C5",
      "$description": "Primary button, unselected option outline, filled progress"
    },
    "violetDeep": {
      "$type": "color",
      "$value": "#792CA2",
      "$description": "Violet side of the result card glow"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Page background, cards and answer cards in light mode; text on violet and on optionSelected"
    },
    "offWhite": {
      "$type": "color",
      "$value": "#ECEAF6",
      "$description": "Input fill and the glow around selected answers"
    },
    "coral": {
      "$type": "color",
      "$value": "#FF6370",
      "$description": "Error outline and error text only"
    },
    "green": {
      "$type": "color",
      "$value": "#61E294",
      "$description": "Positive status"
    },
    "amber": {
      "$type": "color",
      "$value": "#FDC03D",
      "$description": "In the palette; on no screen yet"
    },
    "track": {
      "$type": "color",
      "$value": "#3D3780",
      "$description": "Unfilled progress segments and hairlines. On the screens, not in the palette"
    },
    "optionSelected": {
      "$type": "color",
      "$value": "#2A1F5E",
      "$description": "Selected answer fill. On the screens, not in the palette"
    },
    "selectedOutline": {
      "$type": "color",
      "$value": "#C8C5DA",
      "$description": "Selected answer outline (light mode). On the screens, not in the palette"
    }
  },
  "radius": {
    "pill": {
      "$type": "dimension",
      "$value": {
        "value": 62,
        "unit": "px"
      },
      "$description": "Buttons"
    },
    "card": {
      "$type": "dimension",
      "$value": {
        "value": 22,
        "unit": "px"
      },
      "$description": "Cards and option rows"
    },
    "input": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "segment": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      },
      "$description": "Progress segments"
    }
  },
  "space": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "shellTop": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "shellSide": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    }
  },
  "size": {
    "screen": {
      "$type": "dimension",
      "$value": {
        "value": 390,
        "unit": "px"
      },
      "$description": "Design width"
    },
    "control": {
      "$type": "dimension",
      "$value": {
        "value": 56,
        "unit": "px"
      },
      "$description": "Button height"
    },
    "input": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "font": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Sora"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$description": "Chosen by the designers on 2026-10-11 in place of Aptos, which cannot be served on the web"
    }
  },
  "shadow": {
    "glowForm": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "-5px",
          "offsetY": "-3px",
          "blur": "8px",
          "spread": "3px",
          "color": "#ECEAF6B3"
        },
        {
          "offsetX": "5px",
          "offsetY": "3px",
          "blur": "8px",
          "spread": "3px",
          "color": "#9740C5"
        }
      ],
      "$description": "Form card"
    },
    "glowResult": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "-5px",
          "offsetY": "-3px",
          "blur": "10px",
          "spread": "3px",
          "color": "#ECEAF6B3"
        },
        {
          "offsetX": "5px",
          "offsetY": "3px",
          "blur": "8px",
          "spread": "4px",
          "color": "#792CA2"
        }
      ],
      "$description": "Recommendation card"
    },
    "glowOption": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "8px",
          "spread": "4px",
          "color": "#ECEAF6"
        }
      ],
      "$description": "Selected quiz answer"
    }
  }
}
