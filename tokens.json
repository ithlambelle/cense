{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "ink": { "$type": "color", "$value": "#17211B" },
    "paper": { "$type": "color", "$value": "#F7F8F3" },
    "brand": { "$type": "color", "$value": "#2E6A4B" },
    "brandSoft": { "$type": "color", "$value": "#DCEADF" },
    "accent": { "$type": "color", "$value": "#F2B84B" },
    "danger": { "$type": "color", "$value": "#B43B43" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "control": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
  },
  "space": {
    "unit": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } }
  }
}
